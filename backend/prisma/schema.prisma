generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Collector {
  id        String        @id @default(uuid())
  name      String
  email     String        @unique
  city      String?
  items     StickerItem[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@map("collectors")
}

model StickerItem {
  id          String      @id @default(uuid())
  collectorId String
  stickerCode String
  type        StickerType
  createdAt   DateTime    @default(now())

  collector Collector @relation(fields: [collectorId], references: [id], onDelete: Cascade)

  @@unique([collectorId, stickerCode, type])
  @@map("sticker_items")
}

enum StickerType {
  WANTED
  DUPLICATE
}
